{
  "manifest_version": 3,
  "name": "GitHub Protect",
  "version": "2.0.1",
  "description": "Protects downloads and checks suspicious links with local rules, trusted and blocked domains, alerts, and optional URLhaus reputation.",
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://urlhaus.abuse.ch/*",
    "https://armaanshashvat2014-dot.github.io/github-protect/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GitHub Protect",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.svg"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://armaanshashvat2014-dot.github.io/github-protect/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon.svg"
  }
}
